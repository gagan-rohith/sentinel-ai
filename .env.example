# Copy to .env and fill in. Never commit .env.

APP_ENV=development
LOG_LEVEL=INFO
# json (for log shipping) or console (easier to read locally)
LOG_FORMAT=json
DATABASE_PATH=var/sentinel.db

# Comma separated role:sha256 pairs. Generate each with: python -m auth.api_keys <role>
# Roles: viewer, operator, admin
API_KEYS=

TOOL_TIMEOUT_SECONDS=5

# Search. Use SEARCH_BACKEND=memory to run without Elasticsearch.
SEARCH_BACKEND=elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=sentinel-knowledge
AUTO_INDEX=true

# sentence-transformers (default, needs the ml extra) or hash (no model download, not semantic)
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Optional cross-encoder reranker, for example cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_MODEL=

# Agents. auto uses Claude when ANTHROPIC_API_KEY is set and deterministic heuristics
# otherwise; heuristic forces offline mode; anthropic always calls Claude.
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# Optional thinking effort for Claude: low, medium, high, xhigh or max (unset: model default).
# Thinking tokens are billed as output, so lower effort costs less.
LLM_EFFORT=
LLM_TIMEOUT_SECONDS=60
MAX_CRITIC_RETRIES=3

# Critic: local runs it in-process; a2a delegates plan review to the critic service
# (python -m critic_service). Generate the key pair with python -m critic_service.keys:
# the orchestrator gets the key, the critic service only its hash.
CRITIC_MODE=local
CRITIC_URL=http://localhost:8100
CRITIC_TIMEOUT_SECONDS=10
CRITIC_API_KEY=
CRITIC_API_KEY_SHA256=
CRITIC_PUBLIC_URL=http://localhost:8100

# Optional LangSmith tracing of graph runs, Claude calls and tool calls.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sentinel-ai

# OpenTelemetry tracing, off unless an endpoint is set. Spans go over OTLP/HTTP, for example
# to Jaeger (http://localhost:4318). OTEL_TRACES_EXPORTER=console prints them instead.
# The a2a SDK adds its own internal spans; set OTEL_INSTRUMENTATION_A2A_SDK_ENABLED=false
# to keep only SentinelAI's spans.
OTEL_EXPORTER_OTLP_ENDPOINT=

# MCP over stdio reads its caller key from here (set it in the MCP client config instead).
# SENTINEL_API_KEY=
